  <span style="color:#65656a">|</span><span style="color:#fafafa">@@@@</span><span style="color:#848488">|</span><span style="color:#313138">.</span><span style="color:#38383e">:</span>    <span style="color:#323239">.</span><span style="color:#37373e">:</span>

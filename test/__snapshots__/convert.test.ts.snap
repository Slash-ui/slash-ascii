<pre class="ascii">                
  <span style="color:#3d3d44">/</span><span style="color:#adadb0">----</span><span style="color:#4f4f55">\\</span>        
  <span style="color:#65656a">|</span><span style="color:#fafafa">@@@@</span><span style="color:#838387">|</span>        

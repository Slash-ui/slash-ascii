exports[`rendering > emits html 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>slash-ascii</title>
<style>
  body { margin: 0; background: #0b0b0b; }
  pre.ascii {
    margin: 0;
    padding: 1rem;
    color: #d4d4d4;
